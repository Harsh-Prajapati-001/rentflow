# Supabase (required)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Twilio phone OTP (optional)
# Set to "true" only after configuring Twilio in Supabase Auth → Providers → Phone
# Leave as "false" to use email-only verification
VITE_TWILIO_ENABLED=false
